generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model CicloLectivo {
  id     Int     @id @default(autoincrement())
  año   Int
  activo Boolean @default(true)

  empresas               Empresa[]
  planificacionesAnuales PlanificacionAnual[]

  @@map("ciclo_lectivo")
}

model Usuario {
  id String @id @default(uuid())

  keycloakId String @unique
  email      String @unique

  nombre   String
  apellido String

  rolSistemaId Int

  rolSistema RolesSistema @relation(fields: [rolSistemaId], references: [idRol])

  fotoPerfilUrl      String?
  fotoPerfilPublicId String?

  fechaAlta DateTime @default(now())

  profesorCursos         ProfesorCursos[]
  movimientosFinancieros MovimientoFinanciero[]
  invitacionesCreadas    InvitacionEmpresa[]
  pedidos                Pedido[]
  ordenesAsignadas       OrdenProduccion[]
  historialOrdenes       HistorialEstadoOrdenProduccion[]
  ventas                 Venta[]

  alumno    Alumno?
  auditLogs AuditLog[]

  @@map("usuarios")
}

model Alumno {
  id String @id

  usuario Usuario @relation(fields: [id], references: [id], onDelete: Cascade)

  idCurso Int
  curso   Curso @relation(fields: [idCurso], references: [idCurso])

  idRolEmpresa Int?
  rolEmpresa   RolesEmpresa? @relation(fields: [idRolEmpresa], references: [idRol])

  idEmpresa Int?
  empresa   Empresa? @relation(fields: [idEmpresa], references: [id], onDelete: SetNull)

  auditLogs                 AuditLog[]
  conciliacionesFinancieras ConciliacionFinanciera[]

  @@index([idCurso])
  @@index([idEmpresa])
  @@index([idRolEmpresa])
  @@map("alumnos")
}

model Curso {
  idCurso Int @id @default(autoincrement())

  nombreCurso String @unique
  año        Int

  alumnos    Alumno[]
  profesores ProfesorCursos[]
  empresas   Empresa[]

  @@index([año])
  @@map("cursos")
}

model ProfesorCursos {
  idCurso Int

  idUsuario String

  curso Curso @relation(fields: [idCurso], references: [idCurso], onDelete: Cascade)

  profesor Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@id([idCurso, idUsuario])
  @@map("profesor_cursos")
}

model RolesSistema {
  idRol Int @id @default(autoincrement())

  nombreRol   String  @unique
  descripcion String?

  usuarios Usuario[]

  @@map("roles_sistema")
}

model Empresa {
  id Int @id @default(autoincrement())

  nombre String @unique

  actividad    String
  logoUrl      String?
  logoPublicId String?

  puntos Int @default(0)

  activo        Boolean  @default(true)
  fechaCreacion DateTime @default(now()) @db.Timestamptz(3)

  idCurso Int
  curso   Curso @relation(fields: [idCurso], references: [idCurso])

  idCicloLectivo Int
  cicloLectivo   CicloLectivo @relation(fields: [idCicloLectivo], references: [id])

  alumnos                   Alumno[]
  movimientosFinancieros    MovimientoFinanciero[]
  conciliacionesFinancieras ConciliacionFinanciera[]
  auditLogs                 AuditLog[]
  productos                 Producto[]
  invitaciones              InvitacionEmpresa[]
  pedidos                   Pedido[]
  ordenesProduccion         OrdenProduccion[]
  ventas                    Venta[]
  planificacionesAnuales    PlanificacionAnual[]

  @@index([idCurso])
  @@index([idCicloLectivo])
  @@index([activo])
  @@index([idCurso, activo])
  @@map("empresas")
}

model RolesEmpresa {
  idRol Int @id @default(autoincrement())

  nombreRol String @unique

  descripcion String?

  alumnos Alumno[]

  @@map("roles_empresa")
}

model AuditLog {
  id Int @id @default(autoincrement())

  createdAt DateTime @default(now())

  performedById String
  performedBy   Usuario @relation(fields: [performedById], references: [id])

  action String

  entity   String
  entityId String

  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  alumnoId String?
  alumno   Alumno? @relation(fields: [alumnoId], references: [id], onDelete: SetNull)

  oldValues Json?
  newValues Json?

  description String?

  @@index([performedById])
  @@index([empresaId])
  @@index([alumnoId])
  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model TipoMovimiento {
  idTipoMovimiento Int    @id @default(autoincrement())
  nombre           String @unique

  categorias CategoriaMovimiento[]

  @@map("tipos_movimiento")
}

model CategoriaMovimiento {
  idCategoria Int @id @default(autoincrement())

  nombre      String
  descripcion String?

  idTipoMovimiento Int
  tipoMovimiento   TipoMovimiento @relation(fields: [idTipoMovimiento], references: [idTipoMovimiento])

  movimientos MovimientoFinanciero[]

  @@unique([idTipoMovimiento, nombre])
  @@index([idTipoMovimiento])
  @@map("categorias_movimiento")
}

model EstadoMovimiento {
  idEstado Int    @id @default(autoincrement())
  nombre   String @unique

  movimientos MovimientoFinanciero[]

  @@map("estados_movimiento")
}

model MovimientoFinanciero {
  idMovimiento Int @id @default(autoincrement())

  idEmpresa Int
  empresa   Empresa @relation(fields: [idEmpresa], references: [id])

  idUsuario String
  usuario   Usuario @relation(fields: [idUsuario], references: [id])

  idCategoria Int
  categoria   CategoriaMovimiento @relation(fields: [idCategoria], references: [idCategoria])

  idMetodoPago Int
  metodoPago   MetodoPago @relation(fields: [idMetodoPago], references: [idMetodoPago])

  idEstado Int
  estado   EstadoMovimiento @relation(fields: [idEstado], references: [idEstado])

  ventaId Int?   @unique
  venta   Venta? @relation(fields: [ventaId], references: [idVenta], onDelete: SetNull)

  fecha    DateTime @default(now()) @db.Date
  concepto String
  importe  Decimal  @db.Decimal(14, 2)

  esAutomatico Boolean @default(false)

  referencia    String?
  observaciones String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([idEmpresa])
  @@index([idUsuario])
  @@index([idCategoria])
  @@index([idMetodoPago])
  @@index([idEstado])
  @@index([fecha])
  @@index([idEmpresa, fecha])
  @@map("movimientos_financieros")
}

model Producto {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nombre      String
  descripcion String

  stock Int @default(0)

  precioUnitario        Decimal @db.Decimal(14, 2)
  margenGanancia        Decimal @default(0) @db.Decimal(5, 2)
  precioVenta           Decimal @default(0) @db.Decimal(14, 2)
  precioConsumidorFinal Decimal @default(0) @db.Decimal(14, 2)

  fotoUrl      String?
  fotoPublicId String?

  activo Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  detallesPedido    DetallePedido[]
  detallesVenta     DetalleVenta[]
  ordenesProduccion OrdenProduccion[]

  @@unique([empresaId, nombre], where: { activo: true })
  @@index([empresaId])
  @@index([activo])
  @@map("productos")
}

enum EstadoInvitacion {
  PENDIENTE
  ACEPTADA
  CANCELADA
  EXPIRADA
  FINALIZADA
}

model InvitacionEmpresa {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  email String
  token String @unique

  estado EstadoInvitacion @default(PENDIENTE)

  fechaExpiracion DateTime @db.Timestamptz(3)

  createdById String
  createdBy   Usuario @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([empresaId, email])
  @@index([empresaId])
  @@index([email])
  @@index([estado])
  @@index([createdById])
  @@map("invitaciones_empresa")
}

model EstadoPedido {
  idEstado Int    @id @default(autoincrement())
  nombre   String @unique

  pedidos Pedido[]

  @@map("estados_pedido")
}

model Pedido {
  idPedido Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  estadoId Int
  estado   EstadoPedido @relation(fields: [estadoId], references: [idEstado])

  clienteNombre String

  clienteMail String

  fecha            DateTime @default(now())
  montoTotal       Decimal  @db.Decimal(14, 2)
  montoTotalConIva Decimal  @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  detalles          DetallePedido[]
  ordenesProduccion OrdenProduccion[]
  venta             Venta?

  @@index([empresaId])
  @@index([estadoId])
  @@index([usuarioId])
  @@index([fecha])
  @@index([empresaId, estadoId])
  @@map("pedidos")
}

model DetallePedido {
  idDetallePedido Int @id @default(autoincrement())

  pedidoId Int
  pedido   Pedido @relation(fields: [pedidoId], references: [idPedido], onDelete: Cascade)

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad Int

  cantidadConStock  Int
  cantidadPendiente Int

  precioUnitario Decimal @db.Decimal(14, 2)
  subtotal       Decimal @db.Decimal(14, 2)

  precioUnitarioConIva Decimal @db.Decimal(14, 2)
  subtotalConIva       Decimal @db.Decimal(14, 2)

  // 3. Restricción para evitar que el mismo producto se cargue dos veces en el mismo pedido
  @@unique([pedidoId, productoId])
  @@index([pedidoId])
  @@index([productoId])
  @@map("detalles_pedido")
}

//Definimos la constante (Enum) para la prioridad de ordne de produccion
enum PrioridadOrden {
  ALTA
  MEDIA
  BAJA
}

model EstadoOrdenProduccion {
  idEstado Int    @id @default(autoincrement())
  nombre   String @unique

  ordenes   OrdenProduccion[]
  historial HistorialEstadoOrdenProduccion[]

  @@map("estados_orden_produccion")
}

model OrdenProduccion {
  idOrden Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  estadoId Int
  estado   EstadoOrdenProduccion @relation(fields: [estadoId], references: [idEstado])

  pedidoId Int?
  pedido   Pedido? @relation(fields: [pedidoId], references: [idPedido], onDelete: SetNull)

  responsableId String
  responsable   Usuario @relation(fields: [responsableId], references: [id])

  cantidad Int

  prioridad PrioridadOrden @default(MEDIA)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  historialEstados HistorialEstadoOrdenProduccion[]

  @@unique([pedidoId, productoId], map: "unique_pedido_producto_orden")
  @@index([empresaId])
  @@index([estadoId])
  @@index([responsableId])
  @@index([pedidoId])
  @@index([empresaId, estadoId])
  @@map("ordenes_produccion")
}

model HistorialEstadoOrdenProduccion {
  idHistorial Int @id @default(autoincrement())

  ordenId Int
  orden   OrdenProduccion @relation(fields: [ordenId], references: [idOrden], onDelete: Cascade)

  estadoId Int
  estado   EstadoOrdenProduccion @relation(fields: [estadoId], references: [idEstado])

  // Quién realizó el cambio o qué usuario lo gestionó
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  fechaInicio DateTime  @default(now()) @db.Timestamptz(3)
  fechaFin    DateTime? @db.Timestamptz(3) // Nulo si es el estado actual en el que se encuentra

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([ordenId])
  @@index([estadoId])
  @@index([usuarioId])
  @@map("historial_estado_orden_produccion")
}

enum EstadoPlanificacionAnual {
  PENDIENTE
  CARGADA
}

model PlanificacionAnual {
  idPlanificacion Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  cicloLectivoId Int
  cicloLectivo   CicloLectivo @relation(fields: [cicloLectivoId], references: [id])

  mesInicio Int
  mesFin    Int

  estado EstadoPlanificacionAnual @default(PENDIENTE)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  detalles DetallePlanificacionAnual[]

  @@unique([empresaId, cicloLectivoId])
  @@index([empresaId])
  @@index([cicloLectivoId])
  @@index([estado])
  @@map("planificaciones_anuales")
}

model DetallePlanificacionAnual {
  idDetalle Int @id @default(autoincrement())

  planificacionId Int
  planificacion   PlanificacionAnual @relation(fields: [planificacionId], references: [idPlanificacion], onDelete: Cascade)

  mes               Int
  unidadesEstimadas Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([planificacionId, mes])
  @@index([planificacionId])
  @@map("detalles_planificacion_anual")
}

enum TipoAjusteVenta {
  NINGUNO
  DESCUENTO
  RECARGO
}

enum EstadoVenta {
  CONFIRMADA
}

model Venta {
  idVenta Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  pedidoId Int    @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [idPedido])

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  metodoPagoId Int
  metodoPago   MetodoPago @relation(fields: [metodoPagoId], references: [idMetodoPago])

  estado EstadoVenta @default(CONFIRMADA)

  fecha DateTime @default(now()) @db.Timestamptz(3)

  subtotal Decimal @db.Decimal(14, 2)

  tipoAjuste TipoAjusteVenta @default(NINGUNO)

  porcentajeAjuste Decimal @default(0) @db.Decimal(5, 2)

  importeAjuste Decimal @default(0) @db.Decimal(14, 2)

  aplicaIva Boolean @default(false)

  importeIva Decimal @default(0) @db.Decimal(14, 2)

  cantidadCuotas Int?

  porcentajeInteres Decimal @default(0) @db.Decimal(5, 2)

  importeInteres Decimal @default(0) @db.Decimal(14, 2)

  totalFinal Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  detalles             DetalleVenta[]
  factura              Factura?
  movimientoFinanciero MovimientoFinanciero?

  @@index([empresaId])
  @@index([pedidoId])
  @@index([usuarioId])
  @@index([metodoPagoId])
  @@index([estado])
  @@index([fecha])
  @@index([empresaId, fecha])
  @@map("ventas")
}

model DetalleVenta {
  idDetalleVenta Int @id @default(autoincrement())

  ventaId Int
  venta   Venta @relation(fields: [ventaId], references: [idVenta], onDelete: Cascade)

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad Int

  precioUnitario Decimal @db.Decimal(14, 2)

  subtotal Decimal @db.Decimal(14, 2)

  @@index([ventaId])
  @@index([productoId])
  @@map("detalles_venta")
}

enum TipoFactura {
  A
  B
}

enum CondicionFiscal {
  RESPONSABLE_INSCRIPTO
  CONSUMIDOR_FINAL
}

model Factura {
  idFactura Int @id @default(autoincrement())

  ventaId Int   @unique
  venta   Venta @relation(fields: [ventaId], references: [idVenta])

  tipoFactura TipoFactura

  condicionFiscal CondicionFiscal

  cai String @db.VarChar(14)

  fechaVencimiento DateTime @db.Date

  localidad String @db.VarChar(100)

  fechaEmision DateTime @default(now()) @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([tipoFactura])
  @@index([condicionFiscal])
  @@index([fechaEmision])
  @@map("facturas")
}

model MetodoPago {
  idMetodoPago Int    @id @default(autoincrement())
  nombre       String @unique

  movimientos    MovimientoFinanciero[]
  ventas         Venta[]
  metodosPorAño MetodoPagoCurso[]

  @@map("metodos_pago")
}

model MetodoPagoCurso {
  idMetodoPago Int

  metodoPago MetodoPago @relation(fields: [idMetodoPago], references: [idMetodoPago], onDelete: Cascade)

  año Int

  @@id([idMetodoPago, año])
  @@index([año])
  @@map("metodos_pago_curso")
}

model ConciliacionFinanciera {
  idConciliacion Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  alumnoId String
  alumno   Alumno @relation(fields: [alumnoId], references: [id])

  fecha DateTime @default(now()) @db.Timestamptz(3)

  saldoEsperado Decimal @db.Decimal(14, 2)
  saldoContado  Decimal @db.Decimal(14, 2)
  diferencia    Decimal @db.Decimal(14, 2)

  observacion String? @db.VarChar(250)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([empresaId])
  @@index([alumnoId])
  @@index([fecha])
  @@index([empresaId, fecha])
  @@map("conciliaciones_financieras")
}

model TipoCuentaContable {
  idTipoCuenta Int @id @default(autoincrement())

  nombre      String  @unique
  descripcion String?

  cuentas CuentaContable[]

  @@map("tipos_cuenta_contable")
}

model CuentaContable {
  idCuenta Int @id @default(autoincrement())

  codigo String @unique @db.VarChar(20)

  nombre String @db.VarChar(50)

  idTipoCuenta Int
  tipoCuenta   TipoCuentaContable @relation(fields: [idTipoCuenta], references: [idTipoCuenta])

  descripcion String @db.VarChar(100)

  activo Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([idTipoCuenta])
  @@index([activo])
  @@index([nombre])
  @@map("cuentas_contables")
}
